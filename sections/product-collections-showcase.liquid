<!-- 测试版本：简化的商品集合展示 -->
<div class="product-collections-showcase page-width section-{{ section.id }}-padding">
  <div style="padding: 4rem 0; text-align: center; background: #f9f9f9; border: 2px dashed #ccc;">
    <h2 style="font-size: 2rem; margin-bottom: 2rem;">商品集合展示组件</h2>
    <p style="font-size: 1.2rem; color: #666;">Section已成功加载！</p>
    
    {% if section.blocks.size > 0 %}
      <div style="margin-top: 2rem;">
        <h3>配置的集合：</h3>
        <ul style="list-style: none; padding: 0;">
          {% for block in section.blocks %}
            {% if block.type == 'collection_item' %}
              <li style="margin: 1rem 0; font-size: 1.1rem;">
                {{ block.settings.collection_name | default: 'Collection ' | append: forloop.index }}
                {% if collections[block.settings.collection] %}
                  - ✅ 已连接到集合: {{ collections[block.settings.collection].title }}
                {% else %}
                  - ⚠️ 尚未配置集合
                {% endif %}
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    {% else %}
      <p style="color: #999;">暂无配置的集合块</p>
    {% endif %}
    
    <div style="margin-top: 2rem; font-size: 0.9rem; color: #888;">
      <p>Section ID: {{ section.id }}</p>
      <p>Blocks数量: {{ section.blocks.size }}</p>
    </div>
  </div>
</div>

<style>
.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
  padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
}

@media screen and (min-width: 750px) {
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
}
</style>

{% schema %}
{
  "name": "Product Collections Showcase",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "number",
      "id": "products_limit",
      "label": "Products per collection", 
      "default": 8,
      "info": "Maximum number of products to show in each collection carousel"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Call to action text",
      "default": "View Collection"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range", 
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "collection_item",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection", 
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "collection_name",
          "label": "Custom collection name",
          "info": "Leave empty to use collection title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Collections Showcase",
      "blocks": [
        {
          "type": "collection_item",
          "settings": {
            "collection_name": "Bracelets"
          }
        },
        {
          "type": "collection_item", 
          "settings": {
            "collection_name": "Earclips"
          }
        },
        {
          "type": "collection_item",
          "settings": {
            "collection_name": "Cuffs" 
          }
        },
        {
          "type": "collection_item",
          "settings": {
            "collection_name": "Rings"
          }
        },
        {
          "type": "collection_item",
          "settings": {
            "collection_name": "Necklaces"
          }
        }
      ]
    }
  ]
}
{% endschema %} 